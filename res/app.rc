#include <windows.h>
#define IDI_APP 101

IDI_APP ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "LaoChenShot"
      VALUE "FileDescription", "LaoChenShot Screenshot Tool"
      VALUE "FileVersion", "1.2.0"
      VALUE "ProductName", "LaoChenShot"
      VALUE "ProductVersion", "1.2.0"
      VALUE "OriginalFilename", "LaoChenShot.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
